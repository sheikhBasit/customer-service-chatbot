# Copy to .env and fill in real values:  cp .env.example .env
# NEVER commit .env (it is gitignored). Real keys do not belong in this file.

# --- MongoDB ---
# `make up` (docker compose) overrides this with the bundled mongo container.
# For `make dev` / running locally against the dockerised db:
MONGODB_URL=mongodb://localhost:27017
# Atlas example (TLS is enabled automatically for mongodb+srv:// URLs):
# MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/cscb?retryWrites=true&w=majority
MONGO_DB=cscb

# --- Auth ---
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ALGORITHM=HS256

# --- LLM keys ---
# Groq API key (https://console.groq.com/keys) - REQUIRED for chat replies
GROQ_API_KEY=gsk_your_groq_api_key_here
# Hugging Face token (https://huggingface.co/settings/tokens) - used to download the CLIP model
HF_TOKEN=hf_your_token_here
HUGGINGFACEHUB_API_TOKEN=hf_your_token_here

# --- Redis ---
# `make up` overrides REDIS_URL with the bundled redis container.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# --- Application ---
DEBUG=True
